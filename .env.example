# 复制此文件为 .env，填入你的 API Key
# cp .env.example .env

# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# FMP (Financial Modeling Prep) API
# 免费计划每天500次请求，足够用
# https://financialmodelingprep.com/developer/docs
FMP_API_KEY=xxxxxxxxxxxxxxxx

# 飞书自定义机器人 Webhook（信号卡片）
# 飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制Webhook URL
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
FEISHU_WEBHOOK_SECRET=

# 飞书交易通知（下单/成交/止损，与 YiDong AutoTrader H 同一机器人）
FEISHU_TRADE_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/6753df3d-6097-4fd4-8cbe-b3d817a8a15b

# QuiverQuant (国会交易数据，可选)
# https://www.quiverquant.com/
QUIVER_API_KEY=

# 雪球 Cookie（从浏览器开发者工具复制）
XUEQIU_COOKIE=

# Futu OpenD（与 US_YiDong_AutoTrader 共用）
FUTU_HOST=127.0.0.1
FUTU_PORT=11112
# 实盘必须解锁：优先 FUTU_TRADE_PWD_MD5，否则用明文 FUTU_TRADE_PWD
FUTU_TRADE_PWD=
FUTU_TRADE_PWD_MD5=
FUTU_ACCOUNT_US=                 # REAL 必填，禁止自动选户
FUTU_ACCOUNT_US_SIM=             # SIMULATE 账户（与实盘 ID 不同）

# 交易环境与执行参数
GURU_TRADE_ENV=SIMULATE          # SIMULATE / REAL
GURU_BUDGET_USD=1000
GURU_MAX_POSITIONS=2
GURU_MIN_SCORE=50
GURU_DRAWDOWN_PCT=30
GURU_MIN_POSITION_PCT=0.10
GURU_MAX_HOLD_DAYS=20
GURU_BOLL_PERIOD=20
GURU_TAKE_PROFIT_PCT=0
GURU_STOP_LOSS_PCT=-0.15
